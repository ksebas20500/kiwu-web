---
import Page from '../layouts/Page.astro';
import Cmd from '../components/Cmd.astro';
import Shot from '../components/Shot.astro';
import wDeberes from '../assets/widgets_deberes.png';
import { RAW, REPO } from '../site';
import { fill, type Lang, type Route } from '../i18n';
const { lang, route } = Astro.props as { lang: Lang; route: Route };
const D = {
  es: { title: 'Kiwu para macOS: requisitos, widgets e instalación', h1: 'Kiwu para macOS',
    description: 'Requisitos de Kiwu para macOS 13 o superior, widgets en macOS 14+, instalador universal .dmg y cómo abrir la app, que no está notarizada por Apple.',
    lead: 'App nativa de macOS hecha con SwiftUI, Core Data y WidgetKit. Versión actual: 2.0.', anchor: 'abrir',
    req: 'Requisitos', reqItems: ['macOS 13 (Ventura) o superior para la app.', 'macOS 14 (Sonoma) o superior para los widgets.', 'Instalador universal: Apple Silicon e Intel. El archivo publicado pesa unos 3,5 MB.'],
    dl: 'Descargar e instalar', btn: 'Descargar Kiwu.dmg',
    small: 'El enlace apunta al archivo <code>Kiwu.dmg</code> de la versión más reciente publicada para macOS en <a href="{{RELEASES}}" rel="noopener">GitHub Releases</a>. Página de la versión actual: <a href="{{MACOS_RELEASE}}" rel="noopener">v2.0.0</a> (con el <code>.sha256</code>).',
    o1: 'Opción 1: un comando', o1p: 'Descarga el <code>.dmg</code>, comprueba su suma de verificación, copia la app a Aplicaciones y quita la marca de cuarentena:', o1label: 'Instalar Kiwu en macOS desde la terminal',
    o2: 'Opción 2: a mano', o2p: 'Abre <code>Kiwu.dmg</code> y arrastra <strong>Kiwu</strong> a <em>Aplicaciones</em>.',
    n1: '<strong>La app no está notarizada por Apple.</strong> Notarizar requiere una cuenta de pago, así que al abrirla por primera vez macOS avisará de que no puede verificar al desarrollador (Gatekeeper). Para abrirla:',
    nl: ['<em>Ajustes del Sistema → Privacidad y seguridad → Abrir igualmente</em>, o', 'en la Terminal: <code>xattr -dr com.apple.quarantine /Applications/Kiwu.app</code>'],
    n2: 'El instalador por terminal ya hace esto por ti. Si prefieres no fiarte de un binario, puedes <a href="{{REPO}}/blob/main/macos/README.md" rel="noopener">compilarlo tú mismo</a> (necesita Xcode y firmar con tu propio equipo de desarrollo).',
    wh: 'Widgets', wp: 'En macOS 14 o superior hay tres widgets: <em>Deberes</em> (se completan desde el widget), <em>Nota rápida</em> y <em>Calendario de deberes</em>. Se añaden con clic derecho en el escritorio → <em>Editar widgets</em> → <em>Kiwu</em>; abre la app al menos una vez para que publique los datos.',
    alt: 'Widget Deberes de Kiwu con tareas que se pueden completar desde el escritorio',
    tf: '¿Vienes de TaskFlow?', tfp: 'Kiwu se llamaba TaskFlow en la versión 1.x. Al instalar Kiwu se sustituye la app antigua y, al abrirla, se copian tus listas, tareas, notas y fondo a la nueva carpeta de datos; la carpeta antigua no se borra. Si usabas widgets, quítalos y vuelve a añadirlos.',
    next: 'Siguiente: <a href="{{install}}">todas las formas de instalar</a> · <a href="{{faq}}">preguntas frecuentes</a>. ¿Usas Linux? Mira <a href="{{linux}}">Kiwu para Linux</a>. ¿Android? <a href="{{android}}">Kiwu para Android</a>.' },
  en: { title: 'Kiwu for macOS: requirements, widgets and installation', h1: 'Kiwu for macOS',
    description: 'Kiwu requirements for macOS 13 or later, widgets on macOS 14+, the universal .dmg installer and how to open the app, which is not notarized by Apple.',
    lead: 'A native macOS app built with SwiftUI, Core Data and WidgetKit. Current version: 2.0.', anchor: 'open',
    req: 'Requirements', reqItems: ['macOS 13 (Ventura) or later for the app.', 'macOS 14 (Sonoma) or later for widgets.', 'Universal installer: Apple Silicon and Intel. The published file is about 3.5 MB.'],
    dl: 'Download and install', btn: 'Download Kiwu.dmg',
    small: 'The link points to the <code>Kiwu.dmg</code> file of the latest macOS version published on <a href="{{RELEASES}}" rel="noopener">GitHub Releases</a>. Current version page: <a href="{{MACOS_RELEASE}}" rel="noopener">v2.0.0</a> (with the <code>.sha256</code>).',
    o1: 'Option 1: one command', o1p: 'Downloads the <code>.dmg</code>, verifies its checksum, copies the app to Applications and removes the quarantine flag:', o1label: 'Install Kiwu on macOS from the terminal',
    o2: 'Option 2: by hand', o2p: 'Open <code>Kiwu.dmg</code> and drag <strong>Kiwu</strong> to <em>Applications</em>.',
    n1: '<strong>The app is not notarized by Apple.</strong> Notarizing requires a paid account, so the first time you open it macOS will warn that it cannot verify the developer (Gatekeeper). To open it:',
    nl: ['<em>System Settings → Privacy &amp; Security → Open Anyway</em>, or', 'in Terminal: <code>xattr -dr com.apple.quarantine /Applications/Kiwu.app</code>'],
    n2: 'The terminal installer already does this for you. If you prefer not to trust a binary, you can <a href="{{REPO}}/blob/main/macos/README.md" rel="noopener">build it yourself</a> (it needs Xcode and signing with your own development team).',
    wh: 'Widgets', wp: 'On macOS 14 or later there are three widgets: <em>Homework</em> (completed from the widget), <em>Quick note</em> and <em>Homework calendar</em>. Add them with a right-click on the desktop → <em>Edit Widgets</em> → <em>Kiwu</em>; open the app at least once so it publishes the data.',
    alt: 'Kiwu Homework widget with tasks that can be completed from the desktop',
    tf: 'Coming from TaskFlow?', tfp: 'Kiwu was called TaskFlow in version 1.x. Installing Kiwu replaces the old app and, when you open it, your lists, tasks, notes and background are copied to the new data folder; the old folder is not deleted. If you used widgets, remove them and add them again.',
    next: 'Next: <a href="{{install}}">all ways to install</a> · <a href="{{faq}}">FAQ</a>. On Linux? See <a href="{{linux}}">Kiwu for Linux</a>. On Android? <a href="{{android}}">Kiwu for Android</a>.' },
  pt: { title: 'Kiwu para macOS: requisitos, widgets e instalação', h1: 'Kiwu para macOS',
    description: 'Requisitos do Kiwu para macOS 13 ou superior, widgets no macOS 14+, instalador universal .dmg e como abrir o app, que não é notarizado pela Apple.',
    lead: 'App nativo de macOS feito com SwiftUI, Core Data e WidgetKit. Versão atual: 2.0.', anchor: 'abrir',
    req: 'Requisitos', reqItems: ['macOS 13 (Ventura) ou superior para o app.', 'macOS 14 (Sonoma) ou superior para os widgets.', 'Instalador universal: Apple Silicon e Intel. O arquivo publicado tem cerca de 3,5 MB.'],
    dl: 'Baixar e instalar', btn: 'Baixar Kiwu.dmg',
    small: 'O link aponta para o arquivo <code>Kiwu.dmg</code> da versão mais recente publicada para macOS no <a href="{{RELEASES}}" rel="noopener">GitHub Releases</a>. Página da versão atual: <a href="{{MACOS_RELEASE}}" rel="noopener">v2.0.0</a> (com o <code>.sha256</code>).',
    o1: 'Opção 1: um comando', o1p: 'Baixa o <code>.dmg</code>, verifica o checksum, copia o app para Aplicativos e remove a marca de quarentena:', o1label: 'Instalar o Kiwu no macOS pelo terminal',
    o2: 'Opção 2: manualmente', o2p: 'Abra o <code>Kiwu.dmg</code> e arraste o <strong>Kiwu</strong> para <em>Aplicativos</em>.',
    n1: '<strong>O app não é notarizado pela Apple.</strong> Notarizar exige uma conta paga, então, ao abri-lo pela primeira vez, o macOS avisará que não consegue verificar o desenvolvedor (Gatekeeper). Para abri-lo:',
    nl: ['<em>Ajustes do Sistema → Privacidade e Segurança → Abrir Mesmo Assim</em>, ou', 'no Terminal: <code>xattr -dr com.apple.quarantine /Applications/Kiwu.app</code>'],
    n2: 'O instalador por terminal já faz isso por você. Se preferir não confiar em um binário, você pode <a href="{{REPO}}/blob/main/macos/README.md" rel="noopener">compilá-lo você mesmo</a> (precisa do Xcode e de assinatura com a sua própria equipe de desenvolvimento).',
    wh: 'Widgets', wp: 'No macOS 14 ou superior há três widgets: <em>Trabalhos</em> (concluídos pelo próprio widget), <em>Nota rápida</em> e <em>Calendário de trabalhos</em>. Adicione-os com clique direito na mesa → <em>Editar Widgets</em> → <em>Kiwu</em>; abra o app pelo menos uma vez para que ele publique os dados.',
    alt: 'Widget Trabalhos do Kiwu com tarefas que podem ser concluídas pela mesa',
    tf: 'Vem do TaskFlow?', tfp: 'O Kiwu se chamava TaskFlow na versão 1.x. Ao instalar o Kiwu, o app antigo é substituído e, ao abri-lo, suas listas, tarefas, anotações e fundo são copiados para a nova pasta de dados; a pasta antiga não é apagada. Se você usava widgets, remova-os e adicione-os novamente.',
    next: 'Próximo: <a href="{{install}}">todas as formas de instalar</a> · <a href="{{faq}}">perguntas frequentes</a>. Usa Linux? Veja <a href="{{linux}}">Kiwu para Linux</a>. Android? <a href="{{android}}">Kiwu para Android</a>.' },
}[lang];
const h = (s: string) => fill(lang, s);
---
<Page lang={lang} route={route} title={D.title} h1={D.h1} description={D.description} lead={D.lead}>
  <h2>{D.req}</h2>
  <ul>{D.reqItems.map((i) => <li>{i}</li>)}</ul>
  <h2>{D.dl}</h2>
  <p><a class="btn primary" href={h('{{MACOS_DMG}}')}>{D.btn}</a></p>
  <p class="small" set:html={h(D.small)} />
  <h3>{D.o1}</h3>
  <p set:html={D.o1p} />
  <Cmd lang={lang} cmd={`curl -fsSL ${RAW}/macos/install.sh | bash`} label={D.o1label} />
  <h3>{D.o2}</h3>
  <p set:html={D.o2p} />
  <div class="notice" role="note" id={D.anchor}>
    <p set:html={D.n1} />
    <ul>{D.nl.map((i) => <li set:html={i} />)}</ul>
    <p set:html={h(D.n2)} />
  </div>
  <h2>{D.wh}</h2>
  <p set:html={D.wp} />
  <figure><Shot src={wDeberes} alt={D.alt} sizes="(min-width: 640px) 480px, 100vw" /></figure>
  <h2>{D.tf}</h2>
  <p>{D.tfp}</p>
  <p set:html={h(D.next)} />
</Page>
